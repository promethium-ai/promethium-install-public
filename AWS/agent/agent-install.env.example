# Promethium A' agent install — configuration (copy to agent-install.env, fill in).
# Promethium provides the values marked (Promethium); the rest come from your
# install Terraform outputs.

# Your tenant name (as registered with Promethium).
TENANT=acme

# The Promethium hub principal your agent dials OUT to (mTLS, outbound only).
# (Promethium)
PRINCIPAL_ADDRESS=argocdagent.dev.promethium.ai
PRINCIPAL_PORT=443

# argocd-agent version to install (pin; Promethium tells you the supported ref).
ARGOCD_AGENT_REF=v0.9.0

# Umbrella chart source. 'oci' (recommended) pulls the Promethium umbrella from
# ECR with IAM auth — no GitHub credential ever lands on your cluster.
UMBRELLA_SOURCE=oci

# --- oci mode only -----------------------------------------------------------
# IRSA role IN YOUR ACCOUNT that can pull the umbrella chart from Promethium's
# ECR. Created by the install Terraform; its trust policy names this cluster's
# OIDC provider and the argocd/argocd-ecr-cred-refresher service account.
ECR_REFRESHER_ROLE_ARN=arn:aws:iam::<your-account-id>:role/promethium-<env>-<tenant>-argocd-ecr-refresher
ECR_REGION=us-west-1
# (Promethium) the registry + namespace holding the umbrella chart:
ECR_REGISTRY=734236616923.dkr.ecr.us-west-1.amazonaws.com
CHART_NS=charts

# --- git mode only (not recommended; puts a git credential on your cluster) ---
# GIT_REPO_URL=https://github.com/promethium-ai/promethium-helm-charts.git
# GIT_USERNAME=x
# GIT_PASSWORD=<token>
